{
  "name": "ai-orchestrator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "scripts:check": "node --check ../scripts/sync-frontend.mjs && node --check ../scripts/verify-frontend-bundle.mjs",
    "sync": "node ../scripts/sync-frontend.mjs",
    "verify:bundle": "node ../scripts/verify-frontend-bundle.mjs",
    "check": "npm run scripts:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run sync && npm run verify:bundle"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.9.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
